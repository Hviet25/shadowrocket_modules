DOMAIN-SUFFIX,duolingo.cn,Proxy
DOMAIN-SUFFIX,duolingo.eu,Proxy
DOMAIN-SUFFIX,duolingo.io,Proxy
DOMAIN-SUFFIX,duolingo.tech,Proxy

[Rewrite]
^https:\/\/(ios-api-2|goals-api|ios-api-cf)\.duolingo\.com\/.*users.* script-path=https://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@raw.githubusercontent.com/Hviet25/shadowrocket_modules/main/js/duolingo.js ,requires-body=true, timeout=10, tag=Unlock_Super_Duolingo

[MITM]
hostname = %APPEND% ios-api-2.duolingo.com, goals-api.duolingo.com, ios-api-cf.duolingo.com