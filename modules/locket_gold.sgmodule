#!name=Locket Gold
#!desc=Unlock Gold

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Hviet25/shadowrocket_modules/refs/heads/main/js/locket_gold.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/dhungx/modules-shadowrocket/refs/heads/main/js/locket_gold_deleteHeader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com