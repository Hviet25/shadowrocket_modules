[Script]
Picsart=type=http-response,pattern=https:\/\/api\.(picsart|meiease)\.c(n|om)\/users\/show\/me\.json,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Hviet25/shadowrocket_modules/main/js/picsart.js

[MITM]
hostname = %APPEND% api.picsart.c*, api.meiease.c*